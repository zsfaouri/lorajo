-function asRecord(value: unknown) {
-  return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
-}
-
-function recordString(value: unknown, key: string) {
-  const next = asRecord(value)[key];
-  if (next == null) return "";
