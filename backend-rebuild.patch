+    .replace(/[_-]/g, " ")
+    .replace(/\b\w/g, (c) => c.toUpperCase());
+}
+
+function isColorValue(value: string): boolean {
+  return /^#([0-9a-fA-F]{3,8})$/.test(value.trim());
+}
+
+let toastCounter = 0;
